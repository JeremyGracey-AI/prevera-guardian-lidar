#!/bin/sh
# Structural push gate (2026-09-27): agent runs pushed despite prose "never push".
# Pushes need an explicit per-command opt-in:  ALLOW_PUSH=1 git push ...
if [ "$ALLOW_PUSH" != "1" ]; then
  echo "pre-push: blocked. Re-run as 'ALLOW_PUSH=1 git push ...' after Jeremy approves this push." >&2
  exit 1
fi
