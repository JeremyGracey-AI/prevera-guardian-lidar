<?xml version="1.0"?>
<!--
  PREVERA GUARDIAN+AI Sentinel URDF
  Stationary fall-detection unit for skilled nursing facilities.
  LIDAR is mounted at 0.55 m: catches waist on a standing adult,
  and produces an elongated silhouette for a person on the floor.
-->
<robot name="prevera_sentinel" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="lidar_mount_height" value="0.55"/>
  <xacro:property name="base_size"          value="0.20"/>

  <!-- World-fixed footprint of the sentinel unit. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="${base_size} ${base_size} 0.10"/>
      </geometry>
      <material name="prevera_charcoal">
        <color rgba="0.15 0.15 0.17 1.0"/>
      </material>
    </visual>
  </link>

  <link name="lidar_mount">
    <visual>
      <origin xyz="0 0 ${lidar_mount_height / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${lidar_mount_height}" radius="0.02"/>
      </geometry>
      <material name="prevera_steel">
        <color rgba="0.45 0.45 0.47 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Frame the rplidar driver publishes scans in (must match 'frame_id' param). -->
  <link name="laser"/>

  <joint name="base_to_mount" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_mount"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <joint name="mount_to_laser" type="fixed">
    <parent link="lidar_mount"/>
    <child  link="laser"/>
    <origin xyz="0 0 ${lidar_mount_height}" rpy="0 0 0"/>
  </joint>

</robot>
