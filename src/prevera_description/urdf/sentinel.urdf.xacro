<?xml version="1.0"?>
<!--
  PREVERA GUARDIAN+AI Sentinel URDF
  Stationary fall-detection unit for skilled nursing facilities.

  Scan plane at floor level: the RPLIDAR C1 sits on the tile at the counter base, level (gauge 0.0 deg), and
  its scan window is about 0.02 m above the floor (DR-02, accepted 2026-09-27; measured in
  docs/field-tests/2026-09-27-floor-mount-grid.md). A person lying across or diagonal to the beam is an
  elongated cluster; a standing person is seen as feet. Until 2026-09-28 this file described the original
  design, a 0.55 m mast on a 0.10 m base (a 0.65 m level plane), which never touched a person on the floor
  (docs/field-tests/2026-09-25-rplidar-fall-tests.md); `lidar_mount_height` keeps that history reachable.

  The laser frame is level and right-handed as the sllidar driver publishes it (`inverted: false`,
  rplidar_c1.yaml); the room orientation is in the floor-mount document. LIDAR-to-camera extrinsics are not
  measured yet (docs/DECISIONS.md, DR-14), so no camera link is declared here.
-->
<robot name="prevera_sentinel" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Height of the scan window above the floor. 0.02 = floor mount (DR-02). The original design was 0.65
       (0.55 m mast on a 0.10 m base); pass lidar_mount_height:=0.65 to xacro to draw that rig. -->
  <xacro:arg name="lidar_mount_height" default="0.02"/>
  <xacro:property name="lidar_mount_height" value="$(arg lidar_mount_height)"/>
  <!-- RPLIDAR C1 housing, approximate: 0.056 m across, 0.041 m tall (datasheet); visual only. -->
  <xacro:property name="lidar_radius" value="0.028"/>
  <xacro:property name="lidar_height" value="0.041"/>

  <!-- World-fixed footprint of the sentinel unit: the tile the sensor stands on. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.20 0.005"/>
      </geometry>
      <material name="prevera_charcoal">
        <color rgba="0.15 0.15 0.17 1.0"/>
      </material>
    </visual>
  </link>

  <!-- The sensor body, drawn so that its scan window sits at lidar_mount_height. -->
  <link name="lidar_mount">
    <visual>
      <origin xyz="0 0 ${lidar_height / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${lidar_height}" radius="${lidar_radius}"/>
      </geometry>
      <material name="prevera_steel">
        <color rgba="0.45 0.45 0.47 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Mast between the base plate (0.005 m thick) and the housing, drawn only when the scan window sits high
       enough for one: the original 0.65 m rig had a 0.55 m mast on a 0.10 m base; the floor mount has none. Visual only. -->
  <xacro:property name="mast_length" value="${lidar_mount_height - lidar_height / 2 - 0.005}"/>
  <xacro:if value="${mast_length > 0.001}">
    <link name="lidar_mast">
      <visual>
        <origin xyz="0 0 ${mast_length / 2}" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${mast_length}" radius="0.012"/>
        </geometry>
        <material name="prevera_steel"/>
      </visual>
    </link>
    <joint name="base_to_mast" type="fixed">
      <parent link="base_link"/>
      <child  link="lidar_mast"/>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <!-- Frame the rplidar driver publishes scans in (must match 'frame_id' in rplidar_c1.yaml and fall_detector.yaml). -->
  <link name="laser"/>

  <joint name="base_to_mount" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_mount"/>
    <origin xyz="0 0 ${lidar_mount_height - lidar_height / 2}" rpy="0 0 0"/>
  </joint>

  <joint name="mount_to_laser" type="fixed">
    <parent link="lidar_mount"/>
    <child  link="laser"/>
    <origin xyz="0 0 ${lidar_height / 2}" rpy="0 0 0"/>
  </joint>

</robot>
